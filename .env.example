# PulseGraph AI Environment Variables

# LLM Provider Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# System Settings
LOG_LEVEL=INFO
ENVIRONMENT=development
ENABLE_SAFETY_GUARDRAILS=true
CHECKPOINT_BACKEND=postgres

# Database Configuration (Docker PostgreSQL)
POSTGRES_DB=pulsegraph
POSTGRES_USER=pulsegraph_user
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://pulsegraph_user:your_secure_postgres_password_here@localhost:5432/pulsegraph

# Authentication & Security
PULSEGRAPH_JWT_SECRET=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=10080

# Medical Knowledge APIs (Optional)
PUBMED_API_KEY=
RXNORM_API_BASE_URL=https://rxnav.nlm.nih.gov/REST
